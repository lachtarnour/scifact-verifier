# Copy this file to .env and fill in your values.
# Never commit the real .env to git.

# ── LLM (choose one) ──────────────────────────────────────

# Option 1: Ollama (default — no key needed)
OLLAMA_MODEL=mistral
OLLAMA_URL=http://localhost:11434

# Option 2: Claude API (set this to use Claude instead of Ollama)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Retrieval embedding model ────────────────────────────────────

DEVICE=cpu
DENSE_INDEX_BATCH_SIZE=32
LLM_TOP_K=5
SPECTER2_BASE_MODEL=allenai/specter2_base
SPECTER2_QUERY_ADAPTER=allenai/specter2_adhoc_query
SPECTER2_DOCUMENT_ADAPTER=allenai/specter2
# SPECTER2_LORA_ADAPTER=models/retriever/scifact-lora

# ── Flask ──────────────────────────────────────────────────
FLASK_DEBUG=False
SECRET_KEY=change-me-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
